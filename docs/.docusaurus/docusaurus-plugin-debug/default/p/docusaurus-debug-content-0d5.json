{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/","tagsPath":"/tags","isLast":true,"routePriority":-1,"sidebarFilePath":"C:\\Users\\aarth\\Downloads\\TraceChain\\docs\\sidebars.ts","contentPath":"C:\\Users\\aarth\\Downloads\\TraceChain\\docs\\docs","docs":[{"id":"advanced/context-propagation","title":"Context Propagation","description":"Understanding how TraceChain propagates runid and stepid through your code helps you write correct, observable workflows — especially in async or multi-threaded environments.","source":"@site/docs/advanced/context-propagation.md","sourceDirName":"advanced","slug":"/advanced/context-propagation","permalink":"/advanced/context-propagation","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"context-propagation","title":"Context Propagation","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Custom Clients","permalink":"/advanced/custom-clients"},"next":{"title":"Prompt Versioning","permalink":"/advanced/prompt-versioning"}},{"id":"advanced/custom-clients","title":"Custom Clients","description":"By default, every TraceChain decorator uses a singleton client configured from environment variables. You can override this with a custom TraceChainClient for more control.","source":"@site/docs/advanced/custom-clients.md","sourceDirName":"advanced","slug":"/advanced/custom-clients","permalink":"/advanced/custom-clients","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"custom-clients","title":"Custom Clients","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"Environment Variables","permalink":"/deployment/environment-variables"},"next":{"title":"Context Propagation","permalink":"/advanced/context-propagation"}},{"id":"advanced/prompt-versioning","title":"Prompt Versioning","description":"TraceChain includes a prompt registry — a versioned store of prompt templates. Link each @llm_step to a stored version and see per-version quality metrics in the dashboard.","source":"@site/docs/advanced/prompt-versioning.md","sourceDirName":"advanced","slug":"/advanced/prompt-versioning","permalink":"/advanced/prompt-versioning","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"id":"prompt-versioning","title":"Prompt Versioning","sidebar_position":3},"sidebar":"mainSidebar","previous":{"title":"Context Propagation","permalink":"/advanced/context-propagation"}},{"id":"backend/api-reference","title":"API Reference","description":"All endpoints return JSON. Error responses follow the FastAPI default shape \"message\"}.","source":"@site/docs/backend/api-reference.md","sourceDirName":"backend","slug":"/backend/api-reference","permalink":"/backend/api-reference","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"api-reference","title":"API Reference","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Backend Overview","permalink":"/backend/overview"},"next":{"title":"Database Schema","permalink":"/backend/database"}},{"id":"backend/database","title":"Database Schema","description":"TraceChain uses PostgreSQL with five tables. All primary keys are UUID strings.","source":"@site/docs/backend/database.md","sourceDirName":"backend","slug":"/backend/database","permalink":"/backend/database","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"id":"database","title":"Database Schema","sidebar_position":3},"sidebar":"mainSidebar","previous":{"title":"API Reference","permalink":"/backend/api-reference"},"next":{"title":"Dashboard Overview","permalink":"/dashboard/overview"}},{"id":"backend/overview","title":"Backend Overview","description":"The TraceChain backend is a FastAPI application that stores all observability data in PostgreSQL. It is the central storage and query layer between the SDK and the dashboard.","source":"@site/docs/backend/overview.md","sourceDirName":"backend","slug":"/backend/overview","permalink":"/backend/overview","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"overview","title":"Backend Overview","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"Tracing Context","permalink":"/sdk/tracing"},"next":{"title":"API Reference","permalink":"/backend/api-reference"}},{"id":"dashboard/overview","title":"Dashboard Overview","description":"The TraceChain dashboard is a Next.js 14 application (App Router, Tailwind CSS, Recharts) that gives you a visual interface over all your workflow observability data.","source":"@site/docs/dashboard/overview.md","sourceDirName":"dashboard","slug":"/dashboard/overview","permalink":"/dashboard/overview","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"overview","title":"Dashboard Overview","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"Database Schema","permalink":"/backend/database"},"next":{"title":"Docker Deployment","permalink":"/deployment/docker"}},{"id":"deployment/docker","title":"Docker Deployment","description":"TraceChain ships a docker-compose.yml that starts the entire stack with one command.","source":"@site/docs/deployment/docker.md","sourceDirName":"deployment","slug":"/deployment/docker","permalink":"/deployment/docker","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"docker","title":"Docker Deployment","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"Dashboard Overview","permalink":"/dashboard/overview"},"next":{"title":"Environment Variables","permalink":"/deployment/environment-variables"}},{"id":"deployment/environment-variables","title":"Environment Variables","description":"Complete reference for all environment variables across all three TraceChain components.","source":"@site/docs/deployment/environment-variables.md","sourceDirName":"deployment","slug":"/deployment/environment-variables","permalink":"/deployment/environment-variables","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"environment-variables","title":"Environment Variables","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Docker Deployment","permalink":"/deployment/docker"},"next":{"title":"Custom Clients","permalink":"/advanced/custom-clients"}},{"id":"getting-started/configuration","title":"Configuration","description":"All TraceChain configuration is read from environment variables (with .env file support via python-dotenv).","source":"@site/docs/getting-started/configuration.md","sourceDirName":"getting-started","slug":"/getting-started/configuration","permalink":"/getting-started/configuration","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"id":"configuration","title":"Configuration","sidebar_position":3},"sidebar":"mainSidebar","previous":{"title":"Quickstart","permalink":"/getting-started/quickstart"},"next":{"title":"SDK Overview","permalink":"/sdk/overview"}},{"id":"getting-started/installation","title":"Installation","description":"TraceChain has three components. You need all three for a complete setup, but you can instrument your code with the SDK before the backend is running.","source":"@site/docs/getting-started/installation.md","sourceDirName":"getting-started","slug":"/getting-started/installation","permalink":"/getting-started/installation","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"installation","title":"Installation","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"What is TraceChain?","permalink":"/"},"next":{"title":"Quickstart","permalink":"/getting-started/quickstart"}},{"id":"getting-started/quickstart","title":"Quickstart","description":"This guide takes you from zero to a fully traced LLM workflow. By the end you will see your first run in the dashboard.","source":"@site/docs/getting-started/quickstart.md","sourceDirName":"getting-started","slug":"/getting-started/quickstart","permalink":"/getting-started/quickstart","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"quickstart","title":"Quickstart","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Installation","permalink":"/getting-started/installation"},"next":{"title":"Configuration","permalink":"/getting-started/configuration"}},{"id":"intro","title":"What is TraceChain?","description":"TraceChain is a reliability-first observability framework for LLM workflows. It gives you full visibility into every step, every LLM call, every token spent, and every failure — without changing how you write your pipeline logic.","source":"@site/docs/intro.md","sourceDirName":".","slug":"/","permalink":"/","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"intro","slug":"/","title":"What is TraceChain?","sidebar_position":1},"sidebar":"mainSidebar","next":{"title":"Installation","permalink":"/getting-started/installation"}},{"id":"sdk/evaluations","title":"Evaluations","description":"TraceChain can automatically score the quality of each run. Scores are stored in the database and displayed on the run detail page.","source":"@site/docs/sdk/evaluations.md","sourceDirName":"sdk","slug":"/sdk/evaluations","permalink":"/sdk/evaluations","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":5,"frontMatter":{"id":"evaluations","title":"Evaluations","sidebar_position":5},"sidebar":"mainSidebar","previous":{"title":"@llm_step","permalink":"/sdk/llm-step"},"next":{"title":"Replay","permalink":"/sdk/replay"}},{"id":"sdk/llm-step","title":"@llm_step","description":"The @llm_step decorator wraps a function that makes a single LLM API call. It records the prompt, response, token counts, estimated cost, and latency — and accumulates cost/tokens toward the run total.","source":"@site/docs/sdk/llm-step.md","sourceDirName":"sdk","slug":"/sdk/llm-step","permalink":"/sdk/llm-step","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":4,"frontMatter":{"id":"llm-step","title":"@llm_step","sidebar_position":4},"sidebar":"mainSidebar","previous":{"title":"@step","permalink":"/sdk/step"},"next":{"title":"Evaluations","permalink":"/sdk/evaluations"}},{"id":"sdk/overview","title":"SDK Overview","description":"The TraceChain SDK is a zero-friction instrumentation library for Python. It uses decorators and context variables so you add observability by annotating functions — not by threading IDs through every call.","source":"@site/docs/sdk/overview.md","sourceDirName":"sdk","slug":"/sdk/overview","permalink":"/sdk/overview","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"overview","title":"SDK Overview","sidebar_position":1},"sidebar":"mainSidebar","previous":{"title":"Configuration","permalink":"/getting-started/configuration"},"next":{"title":"@workflow","permalink":"/sdk/workflow"}},{"id":"sdk/replay","title":"Replay","description":"Replay lets you re-execute a previous workflow run with the same input. The new run is linked to the original so you can compare outputs, costs, and quality scores side by side.","source":"@site/docs/sdk/replay.md","sourceDirName":"sdk","slug":"/sdk/replay","permalink":"/sdk/replay","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":6,"frontMatter":{"id":"replay","title":"Replay","sidebar_position":6},"sidebar":"mainSidebar","previous":{"title":"Evaluations","permalink":"/sdk/evaluations"},"next":{"title":"Tracing Context","permalink":"/sdk/tracing"}},{"id":"sdk/step","title":"@step","description":"The @step decorator instruments a discrete unit of work inside a workflow. It records timing, input, output, errors, and optionally retries on failure.","source":"@site/docs/sdk/step.md","sourceDirName":"sdk","slug":"/sdk/step","permalink":"/sdk/step","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"id":"step","title":"@step","sidebar_position":3},"sidebar":"mainSidebar","previous":{"title":"@workflow","permalink":"/sdk/workflow"},"next":{"title":"@llm_step","permalink":"/sdk/llm-step"}},{"id":"sdk/tracing","title":"Tracing Context","description":"TraceChain propagates runid and stepid through Python's contextvars module. You rarely need to interact with these directly, but they are useful for custom logging, manual backend calls, or advanced integrations.","source":"@site/docs/sdk/tracing.md","sourceDirName":"sdk","slug":"/sdk/tracing","permalink":"/sdk/tracing","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"id":"tracing","title":"Tracing Context","sidebar_position":7},"sidebar":"mainSidebar","previous":{"title":"Replay","permalink":"/sdk/replay"},"next":{"title":"Backend Overview","permalink":"/backend/overview"}},{"id":"sdk/workflow","title":"@workflow","description":"The @workflow decorator is the entry point for TraceChain instrumentation. It wraps your pipeline function and manages the full lifecycle of a workflow run record.","source":"@site/docs/sdk/workflow.md","sourceDirName":"sdk","slug":"/sdk/workflow","permalink":"/sdk/workflow","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"workflow","title":"@workflow","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"SDK Overview","permalink":"/sdk/overview"},"next":{"title":"@step","permalink":"/sdk/step"}}],"drafts":[],"sidebars":{"mainSidebar":[{"type":"doc","id":"intro","label":"What is TraceChain?","translatable":true},{"type":"category","label":"Getting Started","collapsed":false,"items":[{"type":"doc","id":"getting-started/installation"},{"type":"doc","id":"getting-started/quickstart"},{"type":"doc","id":"getting-started/configuration"}],"collapsible":true},{"type":"category","label":"Python SDK","items":[{"type":"doc","id":"sdk/overview"},{"type":"doc","id":"sdk/workflow"},{"type":"doc","id":"sdk/step"},{"type":"doc","id":"sdk/llm-step"},{"type":"doc","id":"sdk/evaluations"},{"type":"doc","id":"sdk/replay"},{"type":"doc","id":"sdk/tracing"}],"collapsed":true,"collapsible":true},{"type":"category","label":"Backend API","items":[{"type":"doc","id":"backend/overview"},{"type":"doc","id":"backend/api-reference"},{"type":"doc","id":"backend/database"}],"collapsed":true,"collapsible":true},{"type":"category","label":"Dashboard","items":[{"type":"doc","id":"dashboard/overview"}],"collapsed":true,"collapsible":true},{"type":"category","label":"Deployment","items":[{"type":"doc","id":"deployment/docker"},{"type":"doc","id":"deployment/environment-variables"}],"collapsed":true,"collapsible":true},{"type":"category","label":"Advanced","items":[{"type":"doc","id":"advanced/custom-clients"},{"type":"doc","id":"advanced/context-propagation"},{"type":"doc","id":"advanced/prompt-versioning"}],"collapsed":true,"collapsible":true}]}}]}},"docusaurus-plugin-content-pages":{"default":null},"docusaurus-plugin-debug":{},"docusaurus-plugin-svgr":{},"docusaurus-theme-classic":{},"docusaurus-bootstrap-plugin":{},"docusaurus-mdx-fallback-plugin":{}}}