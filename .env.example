# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=tracechain
POSTGRES_PASSWORD=tracechain_secret
POSTGRES_DB=tracechain
DATABASE_URL=postgresql://tracechain:tracechain_secret@localhost:5432/tracechain

# ─── Backend ──────────────────────────────────────────────────────────────────
TRACECHAIN_ENV=development
BACKEND_PORT=8000

# ─── SDK ──────────────────────────────────────────────────────────────────────
TRACECHAIN_BACKEND_URL=http://localhost:8000
TRACECHAIN_ENABLED=true

# ─── OpenAI (required only for llm_step examples) ─────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
